{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NFD2NFC",
  "mainBinaryName": "NFD2NFC",
  "version": "0.1.0",
  "identifier": "com.nfd2nfc.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NFD2NFC",
        "width": 960,
        "height": 660,
        "minWidth": 780,
        "minHeight": 540,
        "visible": false,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "한글 파일명 자소 분리 해결",
    "longDescription": "macOS의 NFD 파일명을 NFC로 바꿔 Windows로 공유할 때 한글 파일명이 깨지지 않게 합니다.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
